# ==========================================
# Database Configuration
# ==========================================
# 1. Local SQLite (Default for offline local dev):
DATABASE_URL=sqlite+aiosqlite:///./fridgechef.db

# 2. External PostgreSQL (Neon / Supabase / Render):
# Both "postgresql+asyncpg://" and standard "postgresql://" or "postgres://" from Neon/Supabase are supported!
# (The application automatically normalizes the scheme to postgresql+asyncpg://)
# Example Neon:
# DATABASE_URL=postgresql://alex:AbCd1234@ep-cool-flower-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Example Supabase:
# DATABASE_URL=postgresql://postgres.xxx:Password123@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# 3. Local Docker Compose:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fridgechef

# ==========================================
# Server & Environment
# ==========================================
APP_ENV=development
APP_DEBUG=true
PORT=8000
HOST=0.0.0.0

# ==========================================
# CORS Configuration
# ==========================================
# Comma-separated list or JSON array. In production Render, set to your frontend domain or "*"
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# ==========================================
# AI Integration (Google Gemini)
# ==========================================
# Leave empty to use MockRecipeAIProvider for tests and offline dev
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ==========================================
# Default User (for single-user mode)
# ==========================================
DEFAULT_USER_EMAIL=chef@fridgechef.local
DEFAULT_USER_NAME=Chef
